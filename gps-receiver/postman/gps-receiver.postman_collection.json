{
  "info": {
    "_postman_id": "fc904bef-28c0-4d51-bc4d-e908ec8d259e",
    "name": "Internal GPS Receiver",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [{
    "listen": "prerequest",
    "script": { "exec": [
      "const index = (pm.info.iteration || 0) + 1;",
      "pm.variables.set('deviceId', 'AND-' + index.toString(16).toUpperCase().padStart(16, '0'));",
      "pm.variables.set('lat', (10.70 + (index % 100) / 10000).toFixed(6));",
      "pm.variables.set('lon', (106.60 + (index % 100) / 10000).toFixed(6));",
      "pm.variables.set('timestamp', Math.floor(Date.now() / 1000));"
    ]}
  }],
  "item": [
    {
      "name": "OsmAnd GET - app hiện tại",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/?id={{deviceId}}&lat={{lat}}&lon={{lon}}&timestamp={{timestamp}}&speed=3.2&accuracy=8",
          "host": ["{{baseUrl}}"], "path": [""],
          "query": [
            {"key":"id","value":"{{deviceId}}"},{"key":"lat","value":"{{lat}}"},{"key":"lon","value":"{{lon}}"},
            {"key":"timestamp","value":"{{timestamp}}"},{"key":"speed","value":"3.2"},{"key":"accuracy","value":"8"}
          ]
        }
      },
      "event": [{"listen":"test","script":{"exec":["pm.test('Accepted', () => pm.response.to.have.status(200));"]}}]
    },
    {
      "name": "JSON POST",
      "request": {
        "method": "POST",
        "header": [{"key":"Content-Type","value":"application/json"}],
        "body": {"mode":"raw","raw":"{\n  \"id\": \"{{deviceId}}\",\n  \"lat\": {{lat}},\n  \"lon\": {{lon}},\n  \"timestamp\": {{timestamp}},\n  \"speed\": 3.2,\n  \"accuracy\": 8\n}"},
        "url": "{{baseUrl}}/api/locations"
      },
      "event": [{"listen":"test","script":{"exec":["pm.test('Accepted', () => pm.response.to.have.status(200));"]}}]
    },
    {"name":"Health","request":{"method":"GET","url":"{{baseUrl}}/health"}},
    {"name":"Stats","request":{"method":"GET","url":"{{baseUrl}}/api/stats"}},
    {"name":"Devices","request":{"method":"GET","url":"{{baseUrl}}/api/devices"}}
  ]
}
